# Copy this file to .env and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API

# Client-side (public — safe to expose in browser bundles)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side (same URL/publishable key for SSR middleware)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side only — NEVER expose this to the client
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server-side email alerts (Resend). Both admin addresses receive every admin email.
RESEND_API_KEY=re_your_key_here
NOTIFIER_EMAIL=alerts@your-verified-domain.com
ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_2_ALERT_EMAIL=second-admin@example.com
CRON_SECRET=your-random-cron-secret
APP_URL=https://your-app-domain.com
# Optional absolute fallback when the logo is hosted separately from APP_URL.
EMAIL_LOGO_URL=https://your-app-domain.com/garuda-logo.png

# Hosted WhatsApp API used by the HR PDF sending controls. These are server-only.
# Never prefix the key with VITE_ — Vite exposes VITE_* variables to the browser.
WHATSAPP_API_URL=https://wa.garudalogistics.orca.devs.surf
WHATSAPP_API_KEY=your_whatsapp_api_key_here

# Pixabay video search (server-only; never prefix with VITE_)
PIXABAY_API_KEY=your_pixabay_api_key_here

# WMS API base URL used by the WMS screens merged into this ERP bundle.
VITE_WMS_API_URL=https://your-wms-api.example.com

# Windows full-desktop tray companion (public client-side configuration)
# Publish the signed per-user installer at this URL before offering downloads.
VITE_WINDOWS_DESKTOP_AGENT_INSTALLER_URL=https://your-domain.com/downloads/GarudaDesktopAgentSetup-x64.exe
# Optional override; normally the companion listens only on IPv4 loopback.
VITE_WINDOWS_AGENT_WS_URL=ws://127.0.0.1:17654/v1
