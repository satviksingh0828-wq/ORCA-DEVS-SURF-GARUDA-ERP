{
  "expo": {
    "name": "ORCA DEVS SURF",
    "slug": "orca-devs-surf",
    "version": "1.0.0",
    "scheme": "orca-documents",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-light.png",
    "ios": {
      "bundleIdentifier": "com.orcadevssurf.documents",
      "supportsTablet": false
    },
    "android": {
      "package": "com.orcadevssurf.documents",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F4",
        "foregroundImage": "./assets/android-icon-foreground-light.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/icon-light.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ORCA DEVS SURF to scan QR codes and take document photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ORCA DEVS SURF to take a document photo.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F4"
        }
      ],
      "expo-sharing"
    ]
  }
}
