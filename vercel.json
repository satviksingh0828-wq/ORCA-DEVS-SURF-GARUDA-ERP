{
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci --legacy-peer-deps --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth/resource"
    }
  ],
  "crons": [
    {
      "path": "/api/notify-admin",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/notify-admin",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/notify-open-trips",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/fetch-eway-bills",
      "schedule": "30 18 * * *"
    }
  ]
}
